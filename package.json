{
  "name": "engineering-atlas",
  "version": "0.1.0",
  "description": "Curriculum personale di software engineering: baseline SSRI, manutenzione IronMath, evidenze, knowledge graph e lab offline.",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelecorra/engineering-atlas.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:indexes": "node scripts/build-indexes.mjs",
    "build:reports": "node scripts/build-reports.mjs",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "validate:graph": "node scripts/validate-graph.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate": "node scripts/validate.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
