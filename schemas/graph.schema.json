{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-atlas.invalid/schemas/graph.schema.json",
  "title": "graph",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "course",
              "skill",
              "module",
              "assessment",
              "evidence",
              "taxonomy",
              "mastery",
              "unit",
              "lesson"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "PREREQUISITE_OF",
              "RECOMMENDED_BEFORE",
              "PART_OF",
              "REINFORCES",
              "EVIDENCED_BY",
              "REQUIRES_MASTERY",
              "MAPS_TO_TAXONOMY"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "required",
              "recommended",
              "structural",
              "supporting"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "type",
          "strength",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
