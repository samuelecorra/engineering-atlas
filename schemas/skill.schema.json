{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-atlas.invalid/schemas/skill.schema.json",
  "title": "skill",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^skill\\.[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ssri_coverage": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3",
            "C4"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "level",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "ironmath_requirement": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3",
            "M4"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "level",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "primary_course_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^EAT-\\d{3}$"
    },
    "roadmap_taxonomy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "draft",
        "reviewed",
        "validated",
        "deferred",
        "deprecated"
      ]
    },
    "gap": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "confidence",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "aliases",
    "domain",
    "description",
    "ssri_coverage",
    "ironmath_requirement",
    "priority",
    "primary_course_id",
    "roadmap_taxonomy",
    "status",
    "gap"
  ],
  "additionalProperties": false
}
