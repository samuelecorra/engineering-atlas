      "css": ".ds-detail{font-family:'Manrope Variable',sans-serif;padding:24px;background:var(--surface,#0b2330);color:var(--ink,#f6f6f6);border-radius:4px;min-width:0}.ds-detail h2{font-family:\"Nanum Gothic\",sans-serif;font-size:1.5rem;font-weight:700;line-height:1.3;margin:0 0 20px;overflow-wrap:anywhere}.ds-detail p{margin:16px 0;font-size:.9rem;line-height:1.7}.ds-detail .ds-detail-id{font-family:\"JetBrains Mono Variable\",monospace;overflow-wrap:anywhere}"
    },
