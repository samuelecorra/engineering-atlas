      "css": ".ds-statuses{display:flex;flex-wrap:wrap;gap:12px}.ds-status{font-family:'Manrope Variable',sans-serif;display:inline-block;font-size:.8rem;line-height:1.5;color:var(--muted,#becdd6);border:1px solid var(--rule,#344953);border-radius:4px;padding:3px 9px;white-space:nowrap}.ds-status.ds-draft{color:var(--accent,#baf863)}"
    },
