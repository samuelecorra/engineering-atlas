    {
      "name": "Azione principale",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Azione di apertura o recupero, piena e accentata.",
      "html": "<button class=\"ds-primary\">Apri il corso<svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12h18m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:24px;padding:14px 20px;min-height:50px;border:0;border-radius:5px;background:var(--accent,#baf863);color:var(--accent-ink,#112008);font-size:16px;font-weight:700;cursor:pointer}.ds-primary:hover{background:color-mix(in srgb,var(--accent,#baf863),white 15%);color:var(--accent-ink,#112008)}.ds-primary:focus-visible{outline:2px solid var(--focus,#e0ff9b);outline-offset:5px;}.ds-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Azione secondaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Comando bordato; lo stato premuto rimane testuale e semantico.",
      "html": "<button class=\"ds-secondary\" aria-pressed=\"false\">Segna come letta</button>",
      "css": ".ds-secondary{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 18px;border:1px solid var(--rule,#344953);border-radius:4px;background:transparent;color:var(--ink,#f6f6f6);font-size:16px;cursor:pointer}.ds-secondary:hover{border-color:var(--accent,#baf863);color:var(--accent,#baf863)}.ds-secondary[aria-pressed=\"true\"]{color:var(--accent,#baf863)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#e0ff9b);outline-offset:5px;}.ds-secondary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Azione discreta",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Comando della vista o chiusura ricerca senza riempimento.",
      "html": "<button class=\"ds-quiet\" aria-pressed=\"false\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 5h13M8 12h13M8 19h13M3 5h1M3 12h1M3 19h1\"/></svg>Vista elenco</button>",
      "css": ".ds-quiet{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;gap:8px;padding:8px 0;border:0;background:transparent;color:var(--muted,#becdd6);font-size:.85rem;cursor:pointer}.ds-quiet:hover{color:var(--accent,#baf863)}.ds-quiet:focus-visible{outline:2px solid var(--focus,#e0ff9b);outline-offset:5px;}@media(max-width:767px){.ds-quiet{min-height:44px}}"
    },
    {
      "name": "Ricerca del percorso",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Campo del masthead con icona autoriale e label accessibile.",
      "html": "<form class=\"ds-search\" role=\"search\"><svg aria-hidden=\"true\" width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 16l5 5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z\"/></svg><input type=\"search\" aria-label=\"Cerca nel percorso\" placeholder=\"Cerca nel percorso\" autocomplete=\"off\"/></form>",
      "css": ".ds-search{font-family:'Manrope Variable',sans-serif;display:flex;align-items:center;gap:12px;height:44px;padding:0 13px;border:1px solid var(--rule,#344953);border-radius:5px;color:var(--muted,#becdd6)}.ds-search input{font-family:'Manrope Variable',sans-serif;width:100%;min-width:0;border:0;background:transparent;color:var(--ink,#f6f6f6);font-size:16px;caret-color:var(--accent,#baf863)}.ds-search input::placeholder{color:var(--muted,#becdd6);opacity:1}.ds-search input:focus-visible{outline:2px solid var(--focus,#e0ff9b);outline-offset:8px}"
    },
    {
      "name": "Navigazione corrente",
      "kind": "nav",
      "description": "Voce corrente con superficie, icona e indicatore laterale; in orizzontale indicatore inferiore.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigazione principale\"><a class=\"ds-nav-current\" href=\"#mappa\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v3m0 14v3M2 12h3m14 0h3M19 12a7 7 0 1 1-14 0 7 7 0 0 1 14 0ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\"/></svg>Mappa</a></nav>",
      "css": ".ds-nav{font-family:'Manrope Variable',sans-serif;max-width:260px}.ds-nav a{display:flex;align-items:center;gap:24px;height:80px;padding:0 28px;border-radius:0 6px 6px 0;position:relative;text-decoration:none;font-size:1.075rem;background:var(--surface,#0b2330);color:var(--ink,#f6f6f6)}.ds-nav a::before{content:\"\";position:absolute;top:0;bottom:0;left:0;width:4px;background:var(--accent,#baf863)}.ds-nav svg{color:var(--accent,#baf863)}.ds-nav a:hover{color:var(--accent,#baf863)}.ds-nav a:focus-visible{outline:2px solid var(--focus,#e0ff9b);outline-offset:5px;}@media(max-width:1023px){.ds-nav a{height:64px;border-radius:0;padding:0 20px;gap:12px}.ds-nav a::before{height:2px;width:auto;top:auto;right:0}}"
    },
